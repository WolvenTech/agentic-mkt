{
  "name": "agentic-mkt",
  "version": "0.1.0",
  "private": true,
  "description": "Configuration-first home for Wolven's agentic marketing pipeline build/test tooling.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage; status=$?; rm -rf coverage; exit $status",
    "test:live": "pnpm vendor:gate && vitest run --project live",
    "build:workflows": "tsx scripts/build-workflows.ts",
    "build:workflows:check": "tsx scripts/build-workflows-check.ts",
    "deploy:workflows": "tsx scripts/deploy-workflows.ts",
    "validate": "tsx scripts/validate.ts && pnpm harness:validate",
    "vendor:gate": "tsx scripts/vendor-gate.ts",
    "clickup:sync": "tsx scripts/sync-field-mapping.ts",
    "clickup:verify": "tsx scripts/verify-clickup.ts",
    "green-run": "tsx scripts/green-run.ts",
    "executions:inspect": "tsx scripts/inspect-executions.ts",
    "lint:code-nodes": "eslint 'src/workflows/*/code-nodes/**/*.js'",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "lefthook install",
    "harness:validate": "wolven-harness validate",
    "harness:comments": "wolven-harness comments",
    "harness:score": "harness-score"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint/js": "^9.0.0",
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "@wolven-tech/harness": "^0.3.0",
    "ajv": "8.20.0",
    "eslint": "^9.0.0",
    "harness-score": "1.6.5",
    "lefthook": "^2.1.14",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
